# Public app build-time settings (no secrets here)
EXPO_PUBLIC_IJAZAH_AI4X_REALTIME=false
# Optional for same-origin web deployments:
EXPO_PUBLIC_IJAZAH_API_URL=https://YOUR_APP_HOST

# Server-side only — configure in Vercel/VPS environment settings, never commit real values.
IJAZAH_AI4X_STREAM_ENABLED=false
IJAZAH_AI4X_VPS_WS_URL=wss://YOUR_VPS_HOST/ai4x
IJAZAH_AI4X_VPS_TOKEN=replace-with-a-long-random-secret
IJAZAH_ALLOWED_ORIGINS=https://YOUR_APP_HOST

# Legacy provider fallback (use only if VPS settings are both absent):
# NABR_API_KEY=
# NABR_WS_URL=wss://api.qurani.ai
