{
  "expo": {
    "name": "Ijazah",
    "slug": "ijazah",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "ijazah",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.ijazah.app"
    },
    "android": {
      "package": "com.ijazah.app"
    },
    "plugins": [
      "expo-router",
      [
        "expo-audio",
        {
          "microphonePermission": "نحتاج إلى الميكروفون لتسجيل تلاوتك وتحليلها بأمان."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}